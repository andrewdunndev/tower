{
  "name": "tower-page",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "services": [{ "binding": "TOWER", "service": "tower-prober", "entrypoint": "Tower" }],
  "ratelimits": [{ "name": "BEAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
}
