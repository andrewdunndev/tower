{
  "name": "tower-page",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  "services": [{ "binding": "TOWER", "service": "tower-prober", "entrypoint": "Tower" }],
  "ratelimits": [{ "name": "BEAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
}
