---
import '@fontsource-variable/archivo';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/theme.css';
import '../styles/page.css';
import.meta.glob('../../../.tower/theme.css', { eager: true });
import { env } from 'cloudflare:workers';
import type { CheckStatus, Status } from '../lib';
import { statusLabel, fmtDateTime, fmtPct, dayLabel, dayLevel, sparkSummary, mergeIncidents, maintenanceWithBodies, type NoteModule } from '../lib';
import { load } from '../server';

const data = await load(env.TOWER);
if (!data) Astro.response.status = 503;
const checks = data?.checks ?? [];
const notes = await Promise.all(
  Object.values(import.meta.glob<NoteModule>('../../../.tower/notes/*.md', { eager: true })).map(async (m) => ({
    ...m.frontmatter,
    bodyHtml: (await m.compiledContent()).trim() || null,
  })),
);
const incidents = data ? mergeIncidents(data.incidents, notes, data.generatedAt) : [];
const now = data?.generatedAt ?? '';
const maintenance = data ? maintenanceWithBodies(data.maintenance, notes) : [];
const STALE_MS = 3 * 60_000;
const lastRun = data?.last_run;
const stale = data && (!lastRun || Date.parse(data.generatedAt) - Date.parse(lastRun) > STALE_MS);

const order: Status[] = ['down', 'degraded', 'maintenance', 'unknown', 'up'];
const worst = order.find((s) => checks.some((c) => c.status === s)) ?? 'up';
const overall: Record<Status, string> = {
  down: 'Some checks are down',
  degraded: 'Some checks are degraded',
  maintenance: 'Maintenance in progress',
  unknown: 'Some checks have no data',
  up: 'All checks operational',
};
const counts = order
  .map((s) => ({ s, n: checks.filter((c) => c.status === s).length }))
  .filter((x) => x.n);
const word = (s: Status) => statusLabel[s].toLowerCase();
const sevWord = { down: 'down', info: 'maintenance' } as const;

const dur = (fromIso: string, toIso: string) => {
  const mins = Math.max(0, Math.round((Date.parse(toIso) - Date.parse(fromIso)) / 60_000));
  if (mins < 60) return `${mins}m`;
  const h = Math.floor(mins / 60);
  const m = mins % 60;
  if (h < 48) return m ? `${h}h ${m}m` : `${h}h`;
  return `${Math.floor(h / 24)}d`;
};
const ago = (iso: string) => dur(iso, now);

const SW = 120;
const SH = 22;
const BUCKETS = 48;
function sparkPaths(c: CheckStatus): string[] {
  const per = Math.ceil(c.latency.length / BUCKETS);
  const pts = Array.from({ length: BUCKETS }, (_, b) => {
    const vals = c.latency.slice(b * per, (b + 1) * per).filter((v): v is number => v !== null);
    return vals.length ? Math.max(...vals) : null;
  });
  const known = pts.filter((v): v is number => v !== null);
  if (!known.length) return [];
  const top = Math.max(10, ...known);
  const x = (i: number) => (i / (BUCKETS - 1)) * SW;
  const y = (v: number) => SH - 1 - (v / top) * (SH - 2);
  const out: string[] = [];
  let seg: [number, number][] = [];
  const flush = () => {
    if (seg.length === 1) seg.push([seg[0][0] + SW / BUCKETS / 2, seg[0][1]]);
    if (seg.length) out.push(seg.map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`).join(' '));
    seg = [];
  };
  pts.forEach((v, i) => (v === null ? flush() : seg.push([x(i), y(v)])));
  flush();
  return out;
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Status</title>
    <meta name="description" content="Current status, 90-day history and incidents." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="bar">
      <div class="in">
        <span class="brand">
          <svg class="logo" viewBox="0 0 64 64" aria-hidden="true">
            <g stroke="currentColor" fill="none" stroke-linecap="round">
              <rect x="32" y="16" width="22" height="32" stroke-width="3" />
              <line x1="8" y1="40" x2="32" y2="32" stroke-width="3.5" />
              <line x1="36" y1="22" x2="50" y2="22" stroke-width="2" />
              <line x1="36" y1="30" x2="50" y2="30" stroke-width="2" />
              <line x1="36" y1="38" x2="46" y2="38" stroke-width="2" />
            </g>
            <circle cx="8" cy="40" r="4" fill="currentColor" />
          </svg>
          <span class="mark">status</span>
        </span>
        {data && <span class="upd">updated <time datetime={data.generatedAt}>{fmtDateTime(data.generatedAt)}</time></span>}
      </div>
    </header>

    {data ? (
      <main class="in">
        {stale && (
          <p class="panel empty" role="status">
            {lastRun ? `No probe has run since ${fmtDateTime(lastRun)}.` : 'No probe has run yet.'}
          </p>
        )}
        <section class="now" aria-labelledby="overall">
          <h1 id="overall"><i class="g" data-s={worst} aria-hidden="true"></i>{overall[worst]}</h1>
          <ul class="counts" aria-label="Checks by state">
            {counts.map(({ s, n }) => (
              <li><i class="g" data-s={s} aria-hidden="true"></i><b>{n}</b> {word(s)}</li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="checks-h">
          <div class="label">
            <h2 id="checks-h">checks <span>{checks.length}</span></h2>
            <span class="ph" aria-hidden="true"><i data-l="minor">▄</i> minor <i data-l="major">█</i> major <i data-l="none">▁</i> no data · 90 days → today</span>
          </div>
          <div class="panel">
            <div class="row head" aria-hidden="true">
              <span>name</span><span>state</span><span>90 days</span><span>24h latency</span><span class="r">uptime</span><span class="r">p95</span>
            </div>
            <ul class="checks">
              {checks.map((c) => {
                const paths = sparkPaths(c);
                const levels = c.days.map(dayLevel);
                const problems = c.days
                  .map((d, i) => ({ d, i, l: levels[i] }))
                  .filter((x) => x.l === 'minor' || x.l === 'major')
                  .reverse();
                const none = levels.filter((l) => l === 'none').length;
                const stripLabel = `Last 90 days: ${problems.length ? `${problems.length} with disruption` : 'no disruption'}${none ? `, ${none} without data` : ''}.`;
                const strip = (
                  <span class="days" role="img" aria-label={stripLabel}>
                    {levels.map((l) => <span class="d" data-l={l}></span>)}
                  </span>
                );
                return (
                  <li class="row" data-s={c.status}>
                    <h3 class="name">{c.name}</h3>
                    <span class="state"><i class="g" data-s={c.status} aria-hidden="true"></i>{word(c.status)}<span class="for"> · {ago(c.since)}</span><span class="up90"> · {fmtPct(c.uptime90)}</span></span>
                    {problems.length ? (
                      <details class="hist">
                        <summary>{strip}</summary>
                        <ul class="probs">
                          {problems.map(({ d, i, l }) => (
                            <li data-l={l}><span>{dayLabel(now, i)}</span><span>{fmtPct(d)}</span><span>{l}</span></li>
                          ))}
                        </ul>
                      </details>
                    ) : (
                      <div class="hist">{strip}</div>
                    )}
                    <div class="spark">
                      {paths.length ? (
                        <svg viewBox={`0 0 ${SW} ${SH}`} preserveAspectRatio="none" role="img" aria-label={sparkSummary(c)}>
                          {paths.map((p) => <path d={p} />)}
                        </svg>
                      ) : (
                        <span class="nil">no data</span>
                      )}
                    </div>
                    <dl class="fig">
                      <div><dt>uptime</dt><dd>{fmtPct(c.uptime90)}</dd></div>
                      <div><dt>p95</dt><dd>{c.p95 === null ? 'n/a' : <>{c.p95}<small> ms</small></>}</dd></div>
                    </dl>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>

        <section aria-labelledby="inc-h">
          <div class="label"><h2 id="inc-h">incidents</h2><span>last 90 days</span></div>
          {incidents.length ? (
            <ol class="panel log">
              {incidents.map((i) => (
                <li data-open={i.resolved ? undefined : ''} data-done={i.resolved ? '' : undefined}>
                  <time datetime={i.started}>{fmtDateTime(i.started)}</time>
                  <span class="state"><i class="g" data-s={sevWord[i.severity]} aria-hidden="true"></i>{sevWord[i.severity]}</span>
                  <div class="what">
                    <h3>{i.title}</h3>
                    {i.bodyHtml && <div class="body" set:html={i.bodyHtml} />}
                    <p class="on">{i.checks.join(', ')}{i.kind === 'auto' && <span class="tag">auto</span>}</p>
                  </div>
                  <span class="dur">{i.resolved ? `resolved · ${dur(i.started, i.resolved)}` : `ongoing · ${ago(i.started)}`}</span>
                </li>
              ))}
            </ol>
          ) : <p class="panel empty">No incidents in the last 90 days.</p>}
        </section>

        <section aria-labelledby="maint-h">
          <div class="label"><h2 id="maint-h">maintenance</h2><span>scheduled</span></div>
          {maintenance.length ? (
            <ol class="panel log">
              {maintenance.map((m) => (
                <li>
                  <time datetime={m.starts}>{fmtDateTime(m.starts)}</time>
                  <span class="state"><i class="g" data-s="maintenance" aria-hidden="true"></i>planned</span>
                  <div class="what">
                    <h3>{m.title}</h3>
                    {m.bodyHtml && <div class="body" set:html={m.bodyHtml} />}
                    <p class="on">{m.checks.join(', ')}</p>
                  </div>
                  <span class="dur">{dur(m.starts, m.ends)}</span>
                </li>
              ))}
            </ol>
          ) : <p class="panel empty">Nothing scheduled.</p>}
        </section>
      </main>
    ) : (
      <main class="in"><p class="panel empty" role="alert">status unavailable</p></main>
    )}
  </body>
</html>
