    <text x="170" y="86" text-anchor="middle" font-size="12" font-weight="600" fill="var(--text)">flags stalls</text>
    <text x="170" y="102" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">no run for</text>
    <text x="170" y="114" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">3 intervals + 1m</text>
