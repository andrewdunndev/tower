    <rect x="116" y="44" width="108" height="80" rx="6" fill="var(--bg)" stroke="var(--border)"/>
    <text x="170" y="70" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">PROBER</text>
    <text x="170" y="86" text-anchor="middle" font-size="12" font-weight="600" fill="var(--text)">flags checks</text>
    <text x="170" y="102" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">no result for</text>
    <text x="170" y="114" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">3 intervals</text>
