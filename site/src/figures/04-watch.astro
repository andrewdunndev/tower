    <text x="330" y="86" text-anchor="middle" font-size="12" font-weight="600" fill="var(--accent-contrast)">SELF-CHECK</text>
    <text x="330" y="102" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--accent-contrast)" opacity="0.85">FAILING mail</text>
    <rect x="436" y="44" width="108" height="80" rx="6" fill="var(--surface)" stroke="var(--border)"/>
    <text x="490" y="70" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">YOU</text>
    <text x="490" y="86" text-anchor="middle" font-size="12" font-weight="600" fill="var(--text)">read the digest</text>
    <text x="490" y="102" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">none is the alarm</text>
