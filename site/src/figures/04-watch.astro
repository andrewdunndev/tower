    <text x="170" y="230" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">every minute</text>
    <rect x="116" y="300" width="108" height="80" rx="6" fill="var(--surface)" stroke="var(--border)"/>
    <text x="170" y="326" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">OUTSIDE</text>
    <text x="170" y="342" text-anchor="middle" font-size="12" font-weight="600" fill="var(--text)">poller</text>
    <text x="170" y="358" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">optional</text>
  </g>
</svg>
