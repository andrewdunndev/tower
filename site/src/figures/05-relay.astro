    <text x="330" y="70" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="8" letter-spacing="0.08em" fill="var(--text-muted)">MAIL</text>
    <text x="330" y="86" text-anchor="middle" font-size="12" font-weight="600" fill="var(--text)">5 a minute</text>
    <text x="330" y="102" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">rest batched</text>
    <text x="330" y="114" text-anchor="middle" font-family="'IBM Plex Mono', Menlo, monospace" font-size="9" fill="var(--text-2)">one ALERTS mail</text>
