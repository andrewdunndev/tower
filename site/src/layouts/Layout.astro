---
import '../styles/global.css';
import ProjectLayout from '@dunn.dev/reference/chrome/ProjectLayout.astro';
import mark from '../../public/favicon.svg?raw';

interface Props {
  title?: string;
  description?: string;
  headings?: { slug: string; text: string }[];
  section?: { label: string; pages: { href: string; label: string }[] } | null;
}
---
<ProjectLayout
  {...Astro.props}
  siteName="tower.dunn.dev"
  tagline="tower: a status page that runs on Cloudflare Workers"
  mark={mark}
  nav={[
    { href: '/', label: 'Home' },
    { href: '/architecture/', label: 'Architecture' },
    { href: '/setup/', label: 'Install' },
  ]}
  repoUrl="https://gitlab.com/dunn.dev/tower"
>
  <slot />
</ProjectLayout>
